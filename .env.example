# Variables de referencia para VM1. Cada microservicio lee su propio .env
# (copiar este archivo como <servicio>/.env), pero se consolidan aquí para
# tener a la vista qué apunta a dónde en VM3 (bases de datos).

# --- inventario-api (MySQL, inventario_db) ---
# DB_HOST=<IP privada de VM3>
# DB_PORT=3306
# DB_USER=bodega
# DB_PASSWORD=changeme
# DB_NAME=inventario_db

# --- ventas-api (PostgreSQL, ventas_db) ---
# DB_HOST=<IP privada de VM3>
# DB_PORT=5432
# DB_USER=bodega
# DB_PASSWORD=changeme
# DB_NAME=ventas_db

# --- proveedores-api (MySQL, proveedores_db) ---
# DB_HOST=<IP privada de VM3>
# DB_PORT=3306
# DB_USER=bodega
# DB_PASSWORD=changeme
# DB_NAME=proveedores_db
